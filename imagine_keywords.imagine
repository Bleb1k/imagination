/*
`//`            - is a start of single-line comment
  not a comment (actually is) // a comment (duh)

`/*`, `*/`      - start and end of multiline comment (can be nested)
  /* see! doesn't break outer comment */

`///`           - documentation comment, used before the identifier
  /// this function does nothing
  nop :: () {}

`\\\`           - multiline string from zig
  nop :: // same as "This is a multiline string // comments don't work \nFoo Bar Baz"
    \\\This is a {"multiline"} string // comments don't work \\\ // until you mark end of line
    \\\Foo Bar Baz
 // also, this assignment is allowed, but will warn: "WARN: `nop` reassigned, previously assigned (here) and not used"

`#use`          - is used to reference other files or modules (prefix # means that this is a comptime directive)
  my_lib :: #use "my_lib" // searches for file "my_lib.imagine" or folder "my_lib"
  other_lib :: #use "https://github.com/Bleb1k/other_lib#deadbeef" // #commit or #tagname to download an archive of code from
  LocalStorage :: #use "js.LocalStorage" // autogenerated (or manually adjusted) imports of js apis
  console :: #use "js.console" // this is not that great tbh, varargs with any type is not worth it in staticly typed language... at least I don't know how to implement it to be useful and convenient...

`::`, `:=`      - an assignment directive (works just like in jai)
  a :: 0
  b: s32: 1
  c := 2
  d: s8 = 3

`as`            - my own thing, casts to a specific type, like cast(T) in jai
  a :: u16.max
  b :: a as s32
  c :: 1 + b as u32 // will warn, but not crash, also, read as (1 + (b as u8)), 1 is of comptime_int type
  d :: (2 + c) as s64 // as T casts the value or expression it is passed after

`xx`            - an implicit cast, target type must be known, if not, falls through, but warns
  a: s8: 0
  b :: a as xx // will stay the same
  c :: (a + b) as xx // will stay the same
  d :: (foo: s32) => foo
  e :: d(c as xx) // c gets casted to s32

`struct`        - like in C
  Vector2 :: struct {
    x: f32
    y: f32

`self`          - like in rust, except it's not a reference, but either a value, or pointer
  Vector2.add :: (*self, other: Vector2) {
    self.x += other.x
    self.y += other.y
  }
  Vector2.print :: (self) => #print(self)

`packed struct` - like in zig
  SusFlags :: packed struct {
    sussy: bool
    baka: bool
    creeper: s1 // just a sign of a number? it makes sence for cmp ops, but not maths
    sus: u1
    data: s4
  } // actually just u8, instead of u8+u8+u8+u8 :D

`enum`          - like in C
  Direction :: enum { up down left right } // identifiers split by spaces
  Bool :: enum u1 { true: 1 false: 0 } // regex for a single element of body: /(\w+)(?:\s*:\s*(\S+))?/
  OptionEnum :: enum u1 { some: 1, none: 0 }
  void :: enum u0 { null } // seemingly an error, but actually a zero sized type

`union`         - like in zig
  Bar :: union {
    foo: s8
    bar: u16
    baz: f64
    qux: s16x8
  } // size of bar is always the max (in this case v128, or 16 bytes)

`union(enum)`   - tagged union like in zig
  /// type of this will look like Option(T)
  Option :: (T: type) => union (OptionEnum) {
    some: T
    none // if no type supplied, assume it to be void
  }

`void`          - like in zig (think of zig)
  nop :: () {} // return type is void

`using`         - straight from jai
  using std.time
  #print(`{now()}\n`) // this should be possible with zig-like macro engine (i hope) and comptime function variant generation, for now it uses js to generate function to use during runtime
*/
