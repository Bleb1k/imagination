// ----------alias impl----------

fn alias(keyword_a: Identifier, keyword_b: Identifier) Code {
  struct keyword_a { keyword_b }
  impl Deref for keyword_a {
    let Target = keyword_b
    fn deref(self: *Self) &Self.Target { self.0 }
  }
}

